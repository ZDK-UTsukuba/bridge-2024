---
import { subjectsData } from "../content/subjectsSchema";
import { subjectMap } from "../content/subjectsDataAll";
import {
  calcScoreAverageByPeriod,
  groupedToArray,
} from "../content/subjectsDataTypes";
import componentStyles from "./ClassListItem.module.scss";
import Rating from "./Rating.astro";

interface Props {
  subjectId: string;
  searchable?: boolean;
}

const { subjectId, searchable = false } = Astro.props;

const getKdbByName = (subject: string) => {
  return subjectsData.filter((v) => v.name === subject);
};

const subject = subjectMap.get(subjectId);
if (subject == undefined) {
  throw new Error("unknown subject name " + subjectId);
}
const kdbs = getKdbByName(subject.name);
const kdbTeachers = [...new Set(kdbs.flatMap((kdb) => kdb.instructor.value))];

const colleges: string[] = [
  ...new Set(kdbs.map((v) => v.affiliation.name)),
].flatMap((v) => (v ? [v] : []));
const teachers: {
  name: string;
  image?: string;
}[] = kdbTeachers.map((teacher) => ({ name: teacher }));
const rating =
  calcScoreAverageByPeriod(
    subject.subject.recommendation_level_of_this_class,
  ) ?? 0;
const reviewCount = groupedToArray(subject.subject.num).reduce(
  (acc, { value }) => acc + value,
  0,
);

const getRandomColor = () => {
  return `oklch(75% 0.20 ${Math.random() * 360})`;
};
---

<div
  class={componentStyles.item}
  data-search-id={searchable ? subjectId : undefined}
  data-search-title={searchable ? subject.name : undefined}
  data-search-review-count={searchable ? reviewCount : undefined}
  data-search-affiliations={searchable ? JSON.stringify(colleges) : undefined}
  data-search-fields={searchable
    ? JSON.stringify([
        subjectId,
        ...kdbTeachers,
        ...groupedToArray(subject.subject.subject_code).flatMap(
          ({ value }) => value,
        ),
        ...kdbs.map((kdb) => kdb.code),
      ])
    : undefined}
>
  <div class={componentStyles.title}>
    <a href={`/details/${encodeURIComponent(subjectId)}`}>{subject.name}</a>
    {
      colleges.map((college) => (
        <span class={componentStyles.category}>{college}</span>
      ))
    }
  </div>
  <div class={componentStyles.info}>
    <div class={componentStyles.images}>
      {
        teachers.slice(0, 5).map((teacher, teacher_index) => (
          <div
            class={componentStyles.image}
            style={{
              backgroundImage: `url('${teacher.image ?? "/people-default.png"}')`,
              backgroundColor: teacher.image ? "unset" : getRandomColor(),
              zIndex: 100 - teacher_index,
            }}
            title={`${teacher.name} さんのアイコン`}
          />
        ))
      }
    </div>
    <div class={componentStyles.names}>
      {
        teachers[0] && (
          <div class={componentStyles.name}>{teachers[0].name}</div>
        )
      }
      {teachers.length > 1 && <div>他 {teachers.length - 1} 名</div>}
    </div>
    <Rating rating={rating} reviewCount={reviewCount} />
  </div>
</div>
