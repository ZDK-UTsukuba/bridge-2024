---
import {
  subjectPeriods,
  subjectPeriodText,
  type SubjectComment,
  type ValuesByPeriod,
} from "../content/subjectsDataTypes";
import componentStyles from "./SubjectComments.module.scss";
import DetailItem from "./DetailItem.astro";
import Stars from "./Stars.ClassList.astro";

interface Props {
  label: string;
  comments: ValuesByPeriod<readonly SubjectComment[]>;
}

const { label, comments: yearlyValues } = Astro.props;
const comments = subjectPeriods
  .flatMap((year) => {
    const values = yearlyValues[year] ?? [];
    return values.map((comment) => ({ year, comment }));
  })
  .reverse();
---

<DetailItem label={label}>
  <div class={componentStyles.comments}>
    {
      comments.map(({ comment, year }) => (
        <div class={componentStyles.comment}>
          <div class={componentStyles.commentHeader}>
            <Stars num={comment.recommendation_level_of_this_class} />
            <div>{comment.recommendation_level_of_this_class}</div>
          </div>
          <span>{comment.comment}</span> (<span>{subjectPeriodText[year]}</span>)
        </div>
      ))
    }
  </div>
</DetailItem>
