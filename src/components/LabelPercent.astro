---
const { labels, data, n } = Astro.props;
interface Props {
  labels: Record<string, string>;
  data: Record<string, number>;
  n: number;
}
---

<span>
  {
    Object.entries(labels).map(([k, v]) => (
      <div>
        {v}: {n === 0 ? "-" : ((data[k] / n) * 100).toFixed(1)}% ({data[k]}人)
      </div>
    ))
  }
</span>
