---
import componentStyles from "./SearchBox.module.scss";
---

<form class={componentStyles.searchBox} data-searchbox-form action="/search/">
  <div class={componentStyles.inputWrap}>
    <img src="/search.svg" alt="Search" class={componentStyles.icon} />
    <input
      id="searchInput"
      name="q"
      aria-label="科目名・教員名・科目番号で検索"
      type="text"
      class={componentStyles.input}
      placeholder={" " /* "" にすると webkit でうまく動作しない */}
    />
    <div class={componentStyles.suggestions}>
      <div class={componentStyles.container}>
        <p class={componentStyles.item}>確率論</p>
        <p class={componentStyles.item}>微分積分</p>
        <p class={componentStyles.item}>線形代数</p>
        <p class={componentStyles.item}>統計学</p>
        <p class={componentStyles.item}>数学概論</p>
        <p class={componentStyles.item}>確率論</p>
      </div>
      <div class={componentStyles.hint}>
        <p>/ キーでフォーカス</p>
      </div>
    </div>
  </div>
</form>

<script>
  const searchInput = document.getElementById(
    "searchInput",
  ) as HTMLInputElement;
  if (
    window.location.pathname === "/search/" ||
    window.location.pathname === "/search"
  ) {
    searchInput.value =
      new URL(window.location.href).searchParams.get("q") ?? "";
  }

  document.addEventListener("keydown", (event) => {
    const target = event.target;
    const editing =
      target instanceof HTMLElement &&
      (target.isContentEditable ||
        Boolean(target.closest("input, textarea, select")));
    if (
      event.key === "/" &&
      !editing &&
      !event.ctrlKey &&
      !event.metaKey &&
      !event.altKey &&
      !event.isComposing
    ) {
      event.preventDefault();
      searchInput.focus();
    }
    if (event.key === "Escape" && document.activeElement === searchInput) {
      searchInput.blur();
    }
  });
</script>
