---
import pageStyles from "../pages/details/page.module.scss";
import { subjectPeriods, type BooleanSummaryWithDetail, type ValuesByPeriod } from "../content/subjectsDataTypes";
import LabelPercent from "./LabelPercent.astro";

interface Props {
  label: string;
  labels: [True: string, False: string];
  yearlyValues: ValuesByPeriod<BooleanSummaryWithDetail | null>;
}

const { label, labels, yearlyValues } = Astro.props;
const booleanLabels = { True: labels[0], False: labels[1] };
const values = subjectPeriods
  .flatMap((year) => {
    const value = yearlyValues[year];
    return value ? [{ year, value }] : [];
  })
  .reverse();
const head = values.reduce(
  (acc, { value }) => ({
    True: acc.True + value.True,
    False: acc.False + value.False,
  }),
  { True: 0, False: 0 },
);
const details = subjectPeriods
  .flatMap((year) => {
    const value = yearlyValues[year];
    return value ? [{ year, value: value.detail }] : [];
  })
  .reverse();
---

<div class={pageStyles.item}>
  <div class={pageStyles.headItem}>
    <div class={pageStyles.label}>{label}</div>
    <div class={pageStyles.content}>
      <LabelPercent
        labels={booleanLabels}
        n={head.True + head.False}
        data={head}
      /> 
    </div>
  </div>
  {
    values.map(({ year, value }) => (
      <div class={pageStyles.yearItem}>
        <div class={pageStyles.label}>{year}</div>
        <div class={pageStyles.content}>
          <LabelPercent
            labels={booleanLabels}
            n={value.True + value.False}
            data={{
              True: value.True,
              False: value.False,
            }}
          />
        </div>
      </div>
    ))
  }
  <div>
    <ul>
      {
        details.map(({year, value}) => (
          <li class={pageStyles.detail}>
            <span>{value}</span> (<span>{year}</span>)
          </li>
        ))
      }
    </ul>
  </div>
</div>
